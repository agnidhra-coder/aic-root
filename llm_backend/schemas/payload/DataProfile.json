{
  "$defs": {
    "ColumnProfile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "non_null": {
          "title": "Non Null",
          "type": "integer"
        },
        "nulls": {
          "title": "Nulls",
          "type": "integer"
        },
        "zeros": {
          "title": "Zeros",
          "type": "integer"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        }
      },
      "required": [
        "name",
        "dtype",
        "non_null",
        "nulls",
        "zeros"
      ],
      "title": "ColumnProfile",
      "type": "object"
    },
    "Freshness": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "max_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Date"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "lag_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lag Days"
        },
        "refresh_cadence": {
          "title": "Refresh Cadence",
          "type": "string"
        },
        "is_stale": {
          "title": "Is Stale",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "max_date",
        "as_of",
        "lag_days",
        "refresh_cadence",
        "is_stale"
      ],
      "title": "Freshness",
      "type": "object"
    },
    "GrainCoverage": {
      "additionalProperties": false,
