PORT=3001
CORS_ORIGIN=http://localhost:3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# The Python KPI-analysis engine. Server-to-server only — never reachable
# from a browser. Defaults to http://127.0.0.1:8000 when unset, for the case
# where both services run on the same host.
PYTHON_API_URL=http://127.0.0.1:8000

# Required only when PYTHON_API_URL points at a different host (a separate
# deploy) rather than localhost. Must match KPI_API_SHARED_SECRET on the
# Python side exactly. Leave both unset when the two run on one host.
PYTHON_API_SHARED_SECRET=
